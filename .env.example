# CineVault environment — copy to .env and fill in.
# Generate SESSION_SECRET with: openssl rand -hex 32
PORT=6767
MONGO_URL=mongodb://mongo:27017
MONGO_DB=cinevault
SESSION_SECRET=
# Created on first boot when users collection is empty.
ROOT_USER=root
ROOT_PASS=
# Optional: overrides the key stored in DB prefs (admin panel).
TMDB_API_KEY=
# Where uploaded files live (compose sets /data/media; dev default ./data/media).
MEDIA_DIR=

# ---- HTTPS on the server (docker-compose.server.yml only) ----
# HTTPS=1 makes the app serve TLS with a self-signed cert generated on first
# boot (stored in the tls_data volume). Browsers show a one-time "not private"
# warning you accept. It avoids blank pages caused by browsers force-upgrading
# insecure (http://) LAN origins to https. Set via the server override file;
# leave unset for plain HTTP on the dev machine.
# HTTPS=1
# HTTPS_PORT=6767
# HTTP_PORT=8080
